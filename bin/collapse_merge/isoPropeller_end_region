#!/usr/bin/env perl
=start
Author: ALin
Purpose: To generate TSS/TTS regions based on 5' and 3' ends distance, as well as the *_id.txt file generated by isoPropeller_merge_x.pl.
Change log:
	v1.2	2024-09	Fixed the output bed left coordinate.
	v1.3	2025-03	Fixed an issue to proper error reporting when reading the ID file.
	v1.4	2026-10	Replaced the ithreads-based scheduler with a fork()-based worker pool. Fixed a bug in split_chromosome(). Improved I/O efficiency.
=cut

use strict;
use Getopt::Long;
use List::Util qw(max min);
use POSIX qw(:sys_wait_h);
use Benchmark qw(:hireswallclock);

$| = 1;

my $total_start_time = Benchmark->new;

my $version = "v1.4";

my ($in, $out, $id, $num_thread, $help) = ("", "", "", 1, 0);

my $usage = "Usage: perl isoPropeller_end_region_${version}.pl
	-i <String> Input list of _end_dist.txt file(s)
	-o <String> Output base
	-d <String> The _id.txt file generated by isoPropeller_merge
	-t <Integer> The number of threads to use (Default: $num_thread)
	-h <Boolean> Help
";

GetOptions(
	'i=s'	=>	\$in,
	'o=s'	=>	\$out,
	'd=s'	=>	\$id,
	't=i'	=>	\$num_thread,
	'h!'	=>	\$help,
);

if($help){
        print "$usage";
        exit;
}

unless($in && $out && $id){
	print "$usage";
	exit;
}

my $date_format = "+%F-%T.%3N";
my $date = `date $date_format`;
chomp $date;
print "[$date]\tperl isoPropeller_end_region_${version}.pl -i $in -o $out -d $id -t $num_thread\n";

my $dir = "${out}__isoPropeller_end_region_temp";
if(-d $dir){
	print STDERR "<WARNNING> Temporary directory $dir exists! Will overwrite it...\n";
	system("rm ${dir}/*");
}
else{
	system("mkdir $dir");
}

my $total_thread = `grep -c \"^processor\" /proc/cpuinfo`;
chomp $total_thread;
$date = `date $date_format`;
chomp $date;
print "[$date]\tA total of $total_thread threads detected\n";

if($num_thread > $total_thread){
	print "<WARNING> Exceeding the maximal total number of threads! Setting the number of thread to $total_thread...";
	$num_thread = $total_thread;
}

my $start_time = Benchmark->new;
$date = `date $date_format`;
chomp $date;
print "[$date]\tStarting preprocessing (chromosome split)...\n";
my $chr_ref = split_chromosome($dir, $id);
my $finish_time = Benchmark->new;
my $time_spent = timediff($finish_time, $start_time);
$date = `date $date_format`;
chomp $date;
print "[$date]\tUsed ". timestr($time_spent) . " for preprocessing (chromosome split)\n";

$start_time = Benchmark->new;
$date = `date $date_format`;
chomp $date;
print "[$date]\tStarting preprocessing (end_dist split)...\n";
my $num_sample = split_end_dist($dir, $in, $chr_ref);
$finish_time = Benchmark->new;
$time_spent = timediff($finish_time, $start_time);
$date = `date $date_format`;
chomp $date;
print "[$date]\tUsed ". timestr($time_spent) . " for preprocessing (end_dist split across $num_sample sample file(s))\n";

my $chr_pos = 0;
my %running_pid_to_chr = ();
my %failed = ();

while($chr_pos < @$chr_ref || %running_pid_to_chr){
	if($chr_pos < @$chr_ref && (scalar(keys %running_pid_to_chr) < $num_thread)){
		my $temp_chr = $chr_ref->[$chr_pos];
		my $temp_pid = fork();
		unless(defined $temp_pid){
			die "<ERROR> fork() failed: $!\n";
		}
		if($temp_pid == 0){
			#Child
			worker($temp_chr, $dir, $date_format, $num_sample);
			POSIX::_exit(0);
		}
		else{
			#Parent
			$running_pid_to_chr{$temp_pid} = $temp_chr;
			$chr_pos++;
		}
	}
	else{
		reap_one($date_format, \%running_pid_to_chr, \%failed);
	}
}

if(exists $failed{'true'}){
	print STDERR "<ERROR> At least one chromosome worker failed! Aborting before generating final output.\n";
	exit(1);
}

system("cat ${dir}/*_tss.bed | sort -k 1,1 -k 2,2n > ${out}_tss.bed");
system("cat ${dir}/*_tts.bed | sort -k 1,1 -k 2,2n > ${out}_tts.bed");
$date = `date $date_format`;
chomp $date;
print "[$date]\tGenerated output file!\n";
system("rm -r ${dir}");
$date = `date $date_format`;
chomp $date;
print "[$date]\tCleaned temporary files!\n";

my $total_finish_time = Benchmark->new;
my $total_time_spent = timediff($total_finish_time, $total_start_time);
$date = `date $date_format`;
chomp $date;
print "[$date]\tTotal time used: ". timestr($total_time_spent) . "\n";

#Reap a single finished child, update %running_pid_to_chr and %$temp_failed_ref on failure
sub reap_one{
	my ($temp_date_format, $temp_running_ref, $temp_failed_ref) = @_;
	my $temp_pid = waitpid(-1, 0);
	return 0 if $temp_pid <= 0;
	my $temp_status = $?; #Capture immediately: the `date` backtick below is itself a subprocess and would otherwise clobber $?.
	my $temp_chr = delete $temp_running_ref->{$temp_pid};
	$temp_chr = "unknown" unless defined $temp_chr;
	my $temp_date = `date $temp_date_format`;
	chomp $temp_date;
	if($temp_status != 0){
		print STDERR "[$temp_date]\t<ERROR> Worker for $temp_chr failed (status $temp_status)!\n";
		$temp_failed_ref->{'true'} = 1;
	}
	else{
		print "[$temp_date]\tJoined for $temp_chr!\n";
	}

	return 1;
}

sub worker{
	my ($temp_chr, $temp_dir, $temp_date_format, $temp_num_sample) = @_;
	my $temp_date = `date $temp_date_format`;
	chomp $temp_date;
	print "[$temp_date]\tStarting to process $temp_chr...\n";
	my $temp_start_time = Benchmark->new;
	my ($temp_id_ref) = read_id("${temp_dir}/${temp_chr}_id.txt");
	my ($temp_ends_ref) = parse_list($temp_chr, $temp_id_ref, $temp_dir, $temp_num_sample);
	$temp_date = `date $temp_date_format`;
	chomp $temp_date;
	print "[$temp_date]\tParsing file list done for $temp_chr!\n";
	print_bed($temp_ends_ref, $temp_chr, $temp_dir);
	my $temp_finish_time = Benchmark->new;
	my $temp_time_spent = timediff($temp_finish_time, $temp_start_time);
	$temp_date = `date $temp_date_format`;
	chomp $temp_date;
	print "[$temp_date]\tDone for $temp_chr in " . timestr($temp_time_spent) , "!\n";

	return $temp_chr;
}

#Split chromosome: single native-Perl pass over the id file (replaces the previous
#per-chromosome `system("grep ... ")` calls, which (a) rescanned the whole id file once
#per chromosome -- O(chromosomes x file size) -- and (b) relied on bash-only ANSI-C
#quoting ($'\t') that silently matches nothing under a non-bash /bin/sh such as dash).
sub split_chromosome{
	my ($temp_dir, $temp_id) = @_;
	my %temp_chr = ();
	my %temp_out_fh = ();
	open(my $temp_fh, $temp_id) or die "<ERROR> Cannot open $temp_id!\n";
	my $temp_header = 0;
	my %temp_header = ();
	my $temp_header_line = "";
	while(<$temp_fh>){
		chomp;
		my $temp_line = $_;
		$temp_line =~ s/\r//;
		my @temp_line = split('\t', $temp_line);
		if($temp_header == 0){
			for(my $i = 0; $i < @temp_line; $i++){
				if(exists $temp_header{$temp_line[$i]}){
					print STDERR "<ERROR> Duplicated column $temp_line[$i] in $temp_id!\n";
					exit;
				}
				else{
					$temp_header{$temp_line[$i]} = $i;
				}
			}
			unless(exists $temp_header{'chr'}){
				print STDERR "<ERROR> chr absent in $temp_id!\n";
				exit;
			}
			unless(exists $temp_header{'transcript_id'}){
				print STDERR "<ERROR> transcript_id absent in $temp_id!\n";
				exit;
			}
			unless(exists $temp_header{'original_id'}){
				print STDERR "<ERROR> original_id absent in $temp_id!\n";
				exit;
			}
			$temp_header_line = $temp_line;
			$temp_header = 1;
		}
		else{
			my $temp_cur_chr = $temp_line[$temp_header{'chr'}];
			unless(exists $temp_chr{$temp_cur_chr}){
				$temp_chr{$temp_cur_chr} = 1;
				open(my $temp_ofh, "> ${temp_dir}/${temp_cur_chr}_id.txt") or die "<ERROR> Cannot create ${temp_dir}/${temp_cur_chr}_id.txt!\n";
				print $temp_ofh "$temp_header_line\n";
				$temp_out_fh{$temp_cur_chr} = $temp_ofh;
			}
			print { $temp_out_fh{$temp_cur_chr} } "$temp_line\n";
		}
	}
	close $temp_fh;
	foreach my $temp_cur_chr (keys %temp_out_fh){
		close $temp_out_fh{$temp_cur_chr};
	}
	my @temp_chr = keys %temp_chr;

	return \@temp_chr;
}

sub split_end_dist{
	my ($temp_dir, $temp_in, $temp_chr_ref) = @_;
	open(my $temp_list_fh, $temp_in) or die "<ERROR> Cannot open $temp_in!\n";
	my $temp_sample_idx = 0;
	while(<$temp_list_fh>){
		chomp;
		my $temp_file = $_;
		$temp_file =~ s/\r//;
		split_one_end_dist($temp_dir, $temp_file, $temp_sample_idx, $temp_chr_ref);
		$temp_sample_idx++;
	}
	close $temp_list_fh;

	return $temp_sample_idx;
}

sub split_one_end_dist{
	my ($temp_dir, $temp_file, $temp_sample_idx, $temp_chr_ref) = @_;
	open(my $temp_fh, $temp_file) or die "<ERROR> Cannot open $temp_file!\n";
	my %temp_header = ();
	my $temp_header = 0;
	my $temp_header_line = "";
	my %temp_out_fh = ();
	while(<$temp_fh>){
		chomp;
		my $temp_line = $_;
		$temp_line =~ s/\r//;
		my @temp_line = split('\t', $temp_line);
		if($temp_header == 0){
			for(my $i = 0; $i < @temp_line; $i++){
				if(exists $temp_header{$temp_line[$i]}){
					print STDERR "<ERROR> Duplicated column $temp_line[$i] in $temp_file!\n";
					exit;
				}
				else{
					$temp_header{$temp_line[$i]} = $i;
				}
			}
			unless(exists $temp_header{'chr'}){
				print STDERR "<ERROR> chr absent in $temp_file!\n";
				exit;
			}
			unless(exists $temp_header{'transcript_id'}){
				print STDERR "<ERROR> transcript_id absent in $temp_file!\n";
				exit;
			}
			unless(exists $temp_header{'depth'}){
				print STDERR "<ERROR> depth absent in $temp_file!\n";
				exit;
			}
			unless(exists $temp_header{'end_dist'}){
				print STDERR "<ERROR> end_dist absent in $temp_file!\n";
				exit;
			}
			$temp_header_line = $temp_line;
			$temp_header = 1;
			foreach my $temp_c (@$temp_chr_ref){
				open(my $temp_ofh, "> ${temp_dir}/${temp_c}__end_dist__${temp_sample_idx}.txt") or die "<ERROR> Cannot create ${temp_dir}/${temp_c}__end_dist__${temp_sample_idx}.txt!\n";
				print $temp_ofh "$temp_header_line\n";
				$temp_out_fh{$temp_c} = $temp_ofh;
			}
		}
		else{
			my $temp_cur_chr = $temp_line[$temp_header{'chr'}];
			if(exists $temp_out_fh{$temp_cur_chr}){
				print { $temp_out_fh{$temp_cur_chr} } "$temp_line\n";
			}
		}
	}
	close $temp_fh;
	foreach my $temp_c (keys %temp_out_fh){
		close $temp_out_fh{$temp_c};
	}

	return 1;
}

#Read the _id.txt file
sub read_id{
	my ($temp_id) = @_;
	open(my $temp_fh, $temp_id) or die "Cannot open $temp_id!\n";
	my %temp_id = ();
	my $temp_header = 0;
	my %temp_header = ();
	while(<$temp_fh>){
		chomp;
		my $temp_line = $_;
		$temp_line =~ s/\r//;
		my @temp_line = split('\t', $temp_line);
		if($temp_header == 0){
			for(my $i = 0; $i < @temp_line; $i++){
				if(exists $temp_header{$temp_line[$i]}){
					print STDERR "<ERROR> Duplicated column $temp_line[$i] in $temp_id!\n";
					exit;
				}
				else{
					$temp_header{$temp_line[$i]} = $i;
				}
			}
			unless(exists $temp_header{'chr'}){
				print STDERR "<ERROR> chr absent in $temp_id!\n";
				exit;
			}
			unless(exists $temp_header{'transcript_id'}){
				print STDERR "<ERROR> transcript_id absent in $temp_id!\n";
				exit;
			}
			unless(exists $temp_header{'original_id'}){
				print STDERR "<ERROR> original_id absent in $temp_id!\n";
				exit;
			}
			$temp_header = 1;
		}
		else{
			my @temp_original_id = split(',', $temp_line[$temp_header{'original_id'}]);
			foreach my $temp_original_id (@temp_original_id){
				if(exists $temp_id{$temp_original_id}){
					print STDERR "<ERROR> Duplicated ID $temp_original_id in $temp_id!\n";
					exit;
				}
				else{
					$temp_id{$temp_original_id} = $temp_line[$temp_header{'transcript_id'}];
				}
			}
		}
	}
	close $temp_fh;

	return (\%temp_id);
}

#Parse the (pre-split, per-chromosome) end_dist fragments for all samples
sub parse_list{
	my ($temp_chr, $temp_id_ref, $temp_dir, $temp_num_sample)= @_;
	my %temp_ends = ();
	for(my $temp_i = 0; $temp_i < $temp_num_sample; $temp_i++){
		my $temp_split_file = "${temp_dir}/${temp_chr}__end_dist__${temp_i}.txt";
		if(-e $temp_split_file){
			parse_end_dist($temp_chr, \%temp_ends, $temp_id_ref, $temp_split_file);
		}
	}

	return (\%temp_ends);
}

#Parse a end_dist.txt file
sub parse_end_dist{
	my ($temp_chr, $temp_ends_ref, $temp_id_ref, $temp_in) = @_;
	open(my $temp_fh, $temp_in) or die "<ERROR> Cannot open $temp_in!\n";
	my %temp_header = ();
	my $temp_header = 0;
	while(<$temp_fh>){
		chomp;
		my $temp_line = $_;
		$temp_line =~ s/\r//;
		my @temp_line = split('\t', $temp_line);
		if($temp_header == 0){
			for(my $i = 0; $i < @temp_line; $i++){
				if(exists $temp_header{$temp_line[$i]}){
					print STDERR "<ERROR> Duplicated column $temp_line[$i] in $temp_in!\n";
					exit;
				}
				else{
					$temp_header{$temp_line[$i]} = $i;
				}
			}
			unless(exists $temp_header{'chr'}){
				print STDERR "<ERROR> chr absent in $temp_in!\n";
				exit;
			}
			unless(exists $temp_header{'transcript_id'}){
				print STDERR "<ERROR> transcript_id absent in $temp_in!\n";
				exit;
			}
			unless(exists $temp_header{'depth'}){
				print STDERR "<ERROR> depth absent in $temp_in!\n";
				exit;
			}
			unless(exists $temp_header{'end_dist'}){
				print STDERR "<ERROR> end_dist absent in $temp_in!\n";
				exit;
			}
			$temp_header = 1;
		}
		else{
			if(($temp_line[$temp_header{'chr'}] eq $temp_chr) && (exists $temp_id_ref->{$temp_line[$temp_header{'transcript_id'}]})){
				my $temp_transcript_id = $temp_id_ref->{$temp_line[$temp_header{'transcript_id'}]};
				my $temp_strand = $temp_line[$temp_header{'strand'}];
				unless(exists $temp_ends_ref->{$temp_transcript_id}){
					%{$temp_ends_ref->{$temp_transcript_id}} = ();
					$temp_ends_ref->{$temp_transcript_id}{'strand'} = $temp_strand;
				}
				my @temp_end_dist = split(',', $temp_line[$temp_header{'end_dist'}]);
				foreach my $temp_end_dist (@temp_end_dist){
					my ($temp_tss, $temp_tts);
					$temp_end_dist =~ /^(\d+)-(\d+):/;
					if($temp_strand eq '-'){
						($temp_tss, $temp_tts) = ($2, $1);
					}
					else{
						($temp_tss, $temp_tts) = ($1, $2);
					}
					if(exists $temp_ends_ref->{$temp_transcript_id}{'tss'}){
						if($temp_ends_ref->{$temp_transcript_id}{'tss'}[0] > $temp_tss){
							$temp_ends_ref->{$temp_transcript_id}{'tss'}[0] = $temp_tss;
						}
						if($temp_ends_ref->{$temp_transcript_id}{'tss'}[1] < $temp_tss){
							$temp_ends_ref->{$temp_transcript_id}{'tss'}[1] = $temp_tss;
						}
					}
					else{
						@{$temp_ends_ref->{$temp_transcript_id}{'tss'}} = ($temp_tss, $temp_tss);
					}
					if(exists $temp_ends_ref->{$temp_transcript_id}{'tts'}){
						if($temp_ends_ref->{$temp_transcript_id}{'tts'}[0] > $temp_tts){
							$temp_ends_ref->{$temp_transcript_id}{'tts'}[0] = $temp_tts;
						}
						if($temp_ends_ref->{$temp_transcript_id}{'tts'}[1] < $temp_tts){
							$temp_ends_ref->{$temp_transcript_id}{'tts'}[1] = $temp_tts;
						}
					}
					else{
						@{$temp_ends_ref->{$temp_transcript_id}{'tts'}} = ($temp_tts, $temp_tts);
					}
				}

			}
		}
	}
	close $temp_fh;

	return 1;
}

#Print TSS/TTS bed
sub print_bed{
	my ($temp_ends_ref, $temp_chr, $temp_dir) = @_;
	open(my $temp_tss_fh, "> ${temp_dir}/${temp_chr}_tss.bed") or die "<ERROR> Cannot create ${temp_dir}/${temp_chr}_tss.bed!\n";
	open(my $temp_tts_fh, "> ${temp_dir}/${temp_chr}_tts.bed") or die "<ERROR> Cannot create ${temp_dir}/${temp_chr}_tts.bed!\n";
	foreach my $temp_transcript_id (keys %$temp_ends_ref){
		$temp_ends_ref->{$temp_transcript_id}{'tss'}[0]--;
		print $temp_tss_fh "$temp_chr\t$temp_ends_ref->{$temp_transcript_id}{'tss'}[0]\t$temp_ends_ref->{$temp_transcript_id}{'tss'}[1]\t$temp_transcript_id\t.\t$temp_ends_ref->{$temp_transcript_id}{'strand'}\n";
		$temp_ends_ref->{$temp_transcript_id}{'tts'}[0]--;
		print $temp_tts_fh "$temp_chr\t$temp_ends_ref->{$temp_transcript_id}{'tts'}[0]\t$temp_ends_ref->{$temp_transcript_id}{'tts'}[1]\t$temp_transcript_id\t.\t$temp_ends_ref->{$temp_transcript_id}{'strand'}\n";
	}
	close $temp_tss_fh;
	close $temp_tts_fh;
	
	return 1;
}





