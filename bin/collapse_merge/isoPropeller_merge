use strict;
use warnings;
use Getopt::Long;
use List::Util qw(max min);
use POSIX ":sys_wait_h";
use Benchmark qw(:hireswallclock);

$| = 1;

my $total_start_time = Benchmark->new;

my $version = "v1.6.6";

my $usage = "Usage: perl isoPropeller_merge_${version}.pl
	-i <String> Input list of .gtf file(s)
	-o <String> Output base
	-e <String> The atribute for the getting expression value (cov, FPKM, TPM and etc.)
	-p <String> The prefix of gene and transcript IDs (Default: ISOP)
	-t <Integer> Number of worker processes to run at once (Default: 1)
	-h <Boolean> Help
";

my ($in, $out, $exp, $prefix, $num_thread, $help) = ("", "", "", "ISOP", 1, 0);

GetOptions(
	'i=s'	=>	\$in,
	'o=s'	=>	\$out,
	'e=s'	=>	\$exp,
	'p=s'	=>	\$prefix,
	't=i'	=>	\$num_thread,
	'h!'	=>	\$help,
);

if($help){
        print "$usage";
        exit;
}

unless($in && $out){
	print "$usage";
	exit;
}

open(my $out_fh, "> ${out}.gtf") or die "<ERROR> Cannot create ${out}.gtf!\n";
my $date_format = "+%F-%T.%3N";
my $date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tperl isoPropeller_merge_${version}.pl -i $in -o $out -p $prefix -t $num_thread";
print $out_fh "#perl isoPropeller_merge_${version}.pl -i $in -o $out -p $prefix -t $num_thread";
if($exp){
	print " -e $exp";
	print $out_fh " -e $exp";
}
print "\n";
print $out_fh "\n";
close $out_fh;

my $dir = "${out}__isoPropeller_merge_temp";
if(-d $dir){
	print STDERR "<ERROR> Temporary directory $dir exists! Will overwrite it...\n";
	system("rm ${dir}/*");
}
else{
	system("mkdir $dir");
}

my $total_thread = `grep -c \"^processor\" /proc/cpuinfo`;
chomp $total_thread;
$date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tA total of $total_thread threads detected\n";

if($num_thread > $total_thread){
	print "<WARNING> Exceeding the maximal total number of threads! Setting the number of thread to $total_thread...";
	$num_thread = $total_thread;
}

my $start_time = Benchmark->new;
$date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tStarting preprocessing...\n";
my $chr_ref = get_chromosome($in);
my $finish_time = Benchmark->new;
my $time_spent = timediff($finish_time, $start_time);
$date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tUsed ". timestr($time_spent) . " for preprocessing\n";

my %running_pid_to_chr = ();
my $chr_pos = 0;
my %failed = ();

sub reap_one{
	my ($temp_date_format, $temp_running_pid_to_ref, $temp_failed_ref) = @_;
	my $temp_pid = waitpid(-1, 0);
	return 0 if $temp_pid <= 0;
	my $temp_status = $?;
	my $temp_chr = delete $temp_running_pid_to_ref->{$temp_pid};
	return 0 unless defined $temp_chr;
	my $temp_date = `date $temp_date_format`;
	chomp $temp_date;
	if($temp_status != 0){
		print STDERR "[isoPropeller_merge $temp_date]\t<ERROR> Worker for $temp_chr failed (exit status $temp_status)!\n";
		$temp_failed_ref->{'true'} = 1;
	}
	else{
		print "[isoPropeller_merge $temp_date]\tJoined for $temp_chr!\n";
	}
	return 1;
}

while($chr_pos < @$chr_ref){
	while(scalar(keys %running_pid_to_chr) >= $num_thread){
		reap_one($date_format, \%running_pid_to_chr, \%failed);
	}
	my $chr = $chr_ref->[$chr_pos];
	$chr_pos++;
	my $pid = fork();
	unless(defined $pid){
		print STDERR "<ERROR> fork() failed: $!\n";
		$failed{'true'} = 1;
		last;
	}
	if($pid == 0){
		# child
		worker($chr, $dir, $date_format, $in, $exp, $prefix);
		POSIX::_exit(0);
	}
	else{
		$running_pid_to_chr{$pid} = $chr;
	}
}
while(scalar(keys %running_pid_to_chr) > 0){
	reap_one($date_format, \%running_pid_to_chr, \%failed);
}

if(exists $failed{'true'}){
	print STDERR "<ERROR> One or more chromosomes failed; aborting before writing final output.\n";
	exit(1);
}

system("cat ${dir}/*.gtf | sort -k 1,1 -k 4,4n >> ${out}.gtf");
open(my $id_header_fh, "> ${out}_id.txt") or die "<ERROR> Cannot create ${out}_id.txt!\n";
print $id_header_fh "chr\tstrand\tgene_id\ttranscript_id\toriginal_id\tdepth\tend_dist\n";
close $id_header_fh;
system("cat ${dir}/*_id.txt >> ${out}_id.txt");
if($exp){
	open(my $in_fh, $in) or die "<ERROR> Cannot open $in!\n";
	open(my $exp_fh, "> ${out}_exp.txt") or die "<ERROR> Cannot create ${out}_exp.txt!\n";
	print $exp_fh "transcript_id";
	while(<$in_fh>){
		chomp;
		my $file = $_;
		$file =~ s/\r//;
		print $exp_fh "\t$file";
	}
	print $exp_fh "\n";
	close $in_fh;
	close $exp_fh;
	system("cat ${dir}/*_exp.txt >> ${out}_exp.txt");
}
$date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tGenerated output files!\n";
system("rm -r ${dir}");
$date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tCleaned temporary files!\n";

my $total_finish_time = Benchmark->new;
my $total_time_spent = timediff($total_finish_time, $total_start_time);
$date = `date $date_format`;
chomp $date;
print "[isoPropeller_merge $date]\tTotal time used: ". timestr($total_time_spent) . "\n";

sub worker{
	my ($temp_chr, $temp_dir, $temp_date_format, $temp_in, $temp_exp, $temp_prefix) = @_;
	my $temp_date = `date $temp_date_format`;
	chomp $temp_date;
	print "[isoPropeller_merge $temp_date]\tStarting to process $temp_chr...\n";
	my $temp_start_time = Benchmark->new;
	my ($temp_loci_ref, $temp_sample_ref) = parse_list($temp_chr, $temp_in, $temp_exp);
	$temp_date = `date $temp_date_format`;
	chomp $temp_date;
	print "[isoPropeller_merge $temp_date]\tParsing file list done for $temp_chr!\n";
	print_gtf_exp($temp_loci_ref, $temp_sample_ref, $temp_chr, $temp_dir, $temp_in, $temp_exp, $temp_prefix);
	my $temp_finish_time = Benchmark->new;
	my $temp_time_spent = timediff($temp_finish_time, $temp_start_time);
	$temp_date = `date $temp_date_format`;
	chomp $temp_date;
	print "[isoPropeller_merge $temp_date]\tDone for $temp_chr in " . timestr($temp_time_spent) , "!\n";

	return $temp_chr;
}

#Get chromosome
sub get_chromosome{
	my ($temp_in) = @_;
	my %temp_chr = ();
	open(my $temp_list_fh, $temp_in) or die "<ERROR> Cannot open $temp_in!\n";
	while(<$temp_list_fh>){
		chomp;
		my $temp_file = $_;
		$temp_file =~ s/\r//;
		open(my $temp_gtf_fh, $temp_file) or die "<ERROR> Cannot open $temp_in!\n";
		GTF:while(<$temp_gtf_fh>){
			chomp;
			my $temp_line = $_;
			$temp_line =~ s/\r//;
			if($temp_line =~ /^#/){
				next GTF;
			}
			my @temp_line = split('\t', $temp_line);
			if(@temp_line != 9){
				print STDERR "<ERROR> $temp_file doesn't seem to be in .gtf format.\n";
				exit;
			}
			unless(exists $temp_chr{$temp_line[0]}){
				$temp_chr{$temp_line[0]} = 1;
			}
		}
		close $temp_gtf_fh;
	}
	close $temp_list_fh;
	my @temp_chr = keys %temp_chr;

	return \@temp_chr;
}

#Count the number of samples
sub count_sample{
	my ($temp_in, $temp_sample_ref) = @_;
	my $temp_num_sample = 0;
	open(my $temp_fh, $temp_in) or die "<ERROR> Cannot open $temp_in!\n";
	while(<$temp_fh>){
		chomp;
		my $temp_file = $_;
		$temp_file =~ s/\r//;
		push(@$temp_sample_ref, $temp_file);
		$temp_num_sample++;
	}
	close $temp_fh;

	return $temp_num_sample;
}

#Parse the list
sub parse_list{
	my ($temp_chr, $temp_in, $temp_exp) = @_;
	my %temp_loci = ();
	my @temp_sample = ();
	my $temp_num_sample = count_sample($temp_in);
	my $temp_cur_sample = 0;
	open(my $temp_fh, $temp_in) or die "<ERROR> Cannot open $temp_in!\n";
	while(<$temp_fh>){
		chomp;
		my $temp_file = $_;
		$temp_file =~ s/\r//;
		parse_gtf($temp_chr, $temp_file, $temp_num_sample, $temp_cur_sample, \%temp_loci, $temp_exp);
		#Sort loci
		foreach my $temp_strand (keys %temp_loci){
			my @temp_merged = merge_loci($temp_num_sample, $temp_loci{$temp_strand});
			@{$temp_loci{$temp_strand}} = @temp_merged;
			#print "$temp_chr\t$temp_strand\t@{$loci_ref{$temp_strand}}\n";
		}
		#Make an increament of the sample counter
		$temp_cur_sample++;
		push(@temp_sample, $temp_file);
	}
	close $temp_fh;

	return (\%temp_loci, \@temp_sample);
}

#Parse a gtf file
sub parse_gtf{
	my ($temp_chr, $temp_gtf, $temp_num_sample, $temp_cur_sample, $temp_loci_ref, $temp_exp) = @_;
	open(my $temp_fh, $temp_gtf) or die "<ERROR> Cannot open $temp_gtf!\n";
	my %temp_transcript = ();
	my $temp_exp_flag = 0;
	while(<$temp_fh>){
		chomp;
		my $temp_line = $_;
		$temp_line =~ s/\r//;
		my @temp_line = split('\t', $temp_line);
		if(($temp_line[0] eq $temp_chr) && (($temp_line[2] eq "transcript") || ($temp_line[2] eq "exon"))){
			my $temp_transcript_id;
			if($temp_line[8] =~ /transcript_id \"([^\"]+)\"/){
				$temp_transcript_id = $1;
			}
			else{
				print STDERR "<ERROR> Cannot find transcript ID in\n$temp_line\n";
				exit;
			}
			unless(exists $temp_transcript{$temp_transcript_id}){
				%{$temp_transcript{$temp_transcript_id}} = ();
				$temp_transcript{$temp_transcript_id}{'chr'} = $temp_line[0];
				$temp_transcript{$temp_transcript_id}{'strand'} = $temp_line[6];
				@{$temp_transcript{$temp_transcript_id}{'exon'}} = ();
				if($temp_exp){
					$temp_transcript{$temp_transcript_id}{'exp'} = 0;
				}
			}
			if(($temp_exp) && ($temp_line[8] =~ /$temp_exp \"([^\"]+)\"/)){
				$temp_transcript{$temp_transcript_id}{'exp'} = $1;
				$temp_exp_flag = 1;
			}
			if($temp_line[2] eq "exon"){
				my @temp_exon = ($temp_line[3], $temp_line[4]);
				push(@{$temp_transcript{$temp_transcript_id}{'exon'}}, \@temp_exon);
			}
		}
	}
	close $temp_fh;
	if($temp_exp_flag == 0){
		print STDERR "<WARNING> Invalid attribute $temp_exp, no expression data will be output for $temp_chr in $temp_gtf.\n";
	}
	parse_transcript(\%temp_transcript, $temp_num_sample, $temp_cur_sample, $temp_loci_ref);

	return 1;
}

#Parse the transcripts
sub parse_transcript{
	my ($temp_transcript_ref, $temp_num_sample, $temp_cur_sample, $temp_loci_ref) = @_;
	foreach my $temp_transcript_id (keys %{$temp_transcript_ref}){
		#Extract the information of the current transcript for simplicity
		my $temp_strand = $temp_transcript_ref->{$temp_transcript_id}{'strand'};
		my $temp_exp = $temp_transcript_ref->{$temp_transcript_id}{'exp'}; # undef unless -e was given
		my @temp_exon = @{$temp_transcript_ref->{$temp_transcript_id}{'exon'}};
		#Parse the exon structure
		my @temp_sorted_exon = sort {$a->[0] <=> $b->[0]} @temp_exon;
		my $temp_exon_chain = $temp_sorted_exon[0][0] . "-" . $temp_sorted_exon[0][1];
		for(my $i = 1; $i < @temp_sorted_exon; $i++){
			$temp_exon_chain .= "," . $temp_sorted_exon[$i][0] . "-" . $temp_sorted_exon[$i][1];
		}
		my @temp_eej = split('-', $temp_exon_chain);
		my $temp_leftmost = shift @temp_eej;
		my $temp_rightmost = pop @temp_eej;
		my $temp_eej = "-" . join("-", @temp_eej) . "-";
		$temp_eej =~ s/--/-/;
		#print "$temp_chr\t$temp_strand\t$temp_exp\t$temp_exon_chain\n$temp_leftmost\t$temp_rightmost\t$temp_eej\t$temp_transcript_id\n";
		add_transcript($temp_loci_ref, $temp_num_sample, $temp_cur_sample, $temp_strand, $temp_exp, $temp_leftmost, $temp_rightmost, $temp_eej, $temp_transcript_id);
	}

	return 1;
}

sub add_transcript{
	my ($temp_loci_ref, $temp_num_sample, $temp_cur_sample, $temp_strand, $temp_exp, $temp_leftmost, $temp_rightmost, $temp_eej, $temp_transcript_id) = @_;
	#Initiate the strand
	unless(exists $temp_loci_ref->{$temp_strand}){
		@{$temp_loci_ref->{$temp_strand}} = ();
	}
	my $temp_exp_packed = undef;
	if(defined $temp_exp){
		my @temp_exp_vec = (0) x $temp_num_sample;
		$temp_exp_vec[$temp_cur_sample] = $temp_exp;
		$temp_exp_packed = pack("d*", @temp_exp_vec);
	}
	my %temp_transcript = ();
	unless(exists $temp_transcript{$temp_eej}){
		@{$temp_transcript{$temp_eej}} = ();
	}
	my %temp_transcript_id = ();
	unless(exists $temp_transcript_id{$temp_transcript_id}){
		$temp_transcript_id{$temp_transcript_id} = 1;
	}
	my $temp_ends = "$temp_leftmost-$temp_rightmost";
	my %temp_ends = ($temp_ends, 1);
	my @temp_transcript = ($temp_leftmost, $temp_rightmost, $temp_exp_packed, \%temp_transcript_id, \%temp_ends);
	push(@{$temp_transcript{$temp_eej}}, \@temp_transcript);
	my @temp_loci = ($temp_leftmost, $temp_rightmost, \%temp_transcript);
	push(@{$temp_loci_ref->{$temp_strand}}, \@temp_loci);
#	print "Loci:@temp_loci\n";
#	foreach my $i (keys %{$temp_loci[2]}){
#		print "\tEEJ:$i\n";
#		foreach my $j (@{$temp_loci[2]{$i}}){
#			print "\tTranscript:@{$j}\n";
#			my @temp_id = keys %{$j->[3]};
#			print "ID: @temp_id\n";
#		}
#	}

	return 1;
}

#Sort loci
sub merge_loci{
	my ($temp_num_sample, $temp_sref) = @_;

	my @temp_sorted = sort { $a->[0] <=> $b->[0] || $a->[1] <=> $b->[1] } grep { @{$_} } @{$temp_sref};
	my @temp_result = ();
	my $temp_last;

	foreach my $temp_cur (@temp_sorted){
		if(defined $temp_last && $temp_cur->[0] >= $temp_last->[0] && $temp_cur->[0] <= $temp_last->[1]){
			if($temp_cur->[1] > $temp_last->[1]){
				$temp_last->[1] = $temp_cur->[1];
			}
			foreach my $temp_cur_eej (keys %{$temp_cur->[2]}){
				if(exists $temp_last->[2]{$temp_cur_eej}){
					push(@{$temp_last->[2]{$temp_cur_eej}}, @{$temp_cur->[2]{$temp_cur_eej}});
					@{$temp_last->[2]{$temp_cur_eej}} = merge_transcript($temp_num_sample, $temp_last->[2]{$temp_cur_eej});
				}
				else{
					@{$temp_last->[2]{$temp_cur_eej}} = merge_transcript($temp_num_sample, $temp_cur->[2]{$temp_cur_eej});
				}
			}
		}
		else{
			#No overlap: the current locus opens a new cluster
			push(@temp_result, $temp_last) if defined $temp_last;
			$temp_last = $temp_cur;
		}
	}
	push(@temp_result, $temp_last) if defined $temp_last;

	return @temp_result;
}


#Merge transcripts with the same exon-exon junction in the same locus
sub merge_transcript{
	my ($temp_num_sample, $temp_sref) = @_;
	my @temp_sorted = sort { $a->[0] <=> $b->[0] || $a->[1] <=> $b->[1] } grep { @{$_} } @{$temp_sref};
	my @temp_result = ();
	my $temp_last;
	foreach my $temp_cur (@temp_sorted){
		if(defined $temp_last && $temp_cur->[0] >= $temp_last->[0] && $temp_cur->[0] <= $temp_last->[1]){
			if($temp_cur->[1] > $temp_last->[1]){
				$temp_last->[1] = $temp_cur->[1];
			}
			#Sum expression per sample (skipped entirely when -e wasn't given, i.e. both sides' packed vector is undef)
			if(defined $temp_last->[2] || defined $temp_cur->[2]){
				my @temp_a = defined $temp_last->[2] ? unpack("d*", $temp_last->[2]) : (0) x $temp_num_sample;
				my @temp_b = defined $temp_cur->[2] ? unpack("d*", $temp_cur->[2]) : (0) x $temp_num_sample;
				for(my $j = 0; $j < $temp_num_sample; $j++){
					$temp_a[$j] += $temp_b[$j];
				}
				$temp_last->[2] = pack("d*", @temp_a);
			}
			#Union of original transcript IDs
			foreach my $temp_tid (keys %{$temp_cur->[3]}){
				$temp_last->[3]{$temp_tid} = 1 unless exists $temp_last->[3]{$temp_tid};
			}
			#Tally end positions (one increment per distinct end seen in the current transcript)
			foreach my $temp_ends (keys %{$temp_cur->[4]}){
				$temp_last->[4]{$temp_ends} = 0 unless exists $temp_last->[4]{$temp_ends};
				$temp_last->[4]{$temp_ends}++;
			}
		}
		else{
			push(@temp_result, $temp_last) if defined $temp_last;
			$temp_last = $temp_cur;
		}
	}
	push(@temp_result, $temp_last) if defined $temp_last;

	return @temp_result;
}

#Find the representative transcript in the corresponding sub-locus
sub find_rep_transcript{
	my ($temp_rep_transcript_ref, $temp_query_transcript) = @_;
	if($temp_rep_transcript_ref->{$temp_query_transcript} ne $temp_query_transcript){
		my $temp_rep_transcript = find_rep_transcript($temp_rep_transcript_ref, $temp_rep_transcript_ref->{$temp_query_transcript});

		return $temp_rep_transcript;
	}

	return $temp_query_transcript;
}

#Merge the corresponding sub-loci when a pair of transcripts match
sub merge_sub_loci{
	my ($temp_rep_transcript_ref, $temp_sub_loci_size_ref, $temp_rep_region_ref, $temp_transcript_a, $temp_transcript_b) = @_;
	my $temp_rep_transcript_a = find_rep_transcript($temp_rep_transcript_ref, $temp_transcript_a);
	my $temp_rep_transcript_b = find_rep_transcript($temp_rep_transcript_ref, $temp_transcript_b);
	if($temp_rep_transcript_a eq $temp_rep_transcript_b){

		return 0;
	}
	if($temp_sub_loci_size_ref->{$temp_rep_transcript_a} > $temp_sub_loci_size_ref->{$temp_rep_transcript_b}){
		$temp_rep_transcript_ref->{$temp_rep_transcript_b} = $temp_rep_transcript_a;
		$temp_sub_loci_size_ref->{$temp_rep_transcript_a} += $temp_sub_loci_size_ref->{$temp_rep_transcript_b};
		if($temp_rep_region_ref->{$temp_rep_transcript_b}[0] < $temp_rep_region_ref->{$temp_rep_transcript_a}[0]){
			$temp_rep_region_ref->{$temp_rep_transcript_a}[0] = $temp_rep_region_ref->{$temp_rep_transcript_b}[0];
		}
		if($temp_rep_region_ref->{$temp_rep_transcript_b}[1] > $temp_rep_region_ref->{$temp_rep_transcript_a}[1]){
			$temp_rep_region_ref->{$temp_rep_transcript_a}[1] = $temp_rep_region_ref->{$temp_rep_transcript_b}[1];
		}
	}
	else{
		$temp_rep_transcript_ref->{$temp_rep_transcript_a} = $temp_rep_transcript_b;
		$temp_sub_loci_size_ref->{$temp_rep_transcript_b} += $temp_sub_loci_size_ref->{$temp_rep_transcript_a};
		if($temp_rep_region_ref->{$temp_rep_transcript_a}[0] < $temp_rep_region_ref->{$temp_rep_transcript_b}[0]){
			$temp_rep_region_ref->{$temp_rep_transcript_b}[0] = $temp_rep_region_ref->{$temp_rep_transcript_a}[0];
		}
		if($temp_rep_region_ref->{$temp_rep_transcript_a}[1] > $temp_rep_region_ref->{$temp_rep_transcript_b}[1]){
			$temp_rep_region_ref->{$temp_rep_transcript_b}[1] = $temp_rep_region_ref->{$temp_rep_transcript_a}[1];
		}
	}

	return 1;
}

#Divide a locus into sub-loci via a splice-site index (replaces the all-pairs scan)
sub locus_sub_cluster{
	my ($temp_locus_ref) = @_;
	my %temp_rep_transcript = ();
	my %temp_sub_loci_size = ();
	my %temp_rep_region = ();
	my %temp_sub_loci = ();
	my %temp_sub_loci_region = ();
	my %temp_exons = ();     #key -> arrayref of [l,r], pre-split once
	my @temp_single = ();    #single-exon transcript keys
	my %temp_donor = ();     #internal right-boundary coord -> [keys]
	my %temp_acceptor = ();  #internal left-boundary coord  -> [keys]

	foreach my $temp_eej (sort keys %{$temp_locus_ref->[2]}){
		foreach my $temp_transcript (@{$temp_locus_ref->[2]{$temp_eej}}){
			my $temp_eej_new = $temp_transcript->[0]. $temp_eej . $temp_transcript->[1];
			next if exists $temp_rep_transcript{$temp_eej_new};   #distinct keys only
			@{$temp_rep_region{$temp_eej_new}} = ($temp_transcript->[0], $temp_transcript->[1]);
			$temp_rep_transcript{$temp_eej_new} = $temp_eej_new;
			$temp_sub_loci_size{$temp_eej_new} = 1;
			$temp_sub_loci{$temp_eej_new} = 0;
			my @temp_ex = map { [split '-', $_] } split(',', $temp_eej_new);
			$temp_exons{$temp_eej_new} = \@temp_ex;
			my $temp_k = @temp_ex;
			if($temp_k == 1){
				push(@temp_single, $temp_eej_new);
			}
			else{
				#Donors: right coord of every exon except the last
				for(my $i = 0; $i < $temp_k - 1; $i++){
					push(@{$temp_donor{$temp_ex[$i][1]}}, $temp_eej_new);
				}
				#Acceptors: left coord of every exon except the first
				for(my $i = 1; $i < $temp_k; $i++){
					push(@{$temp_acceptor{$temp_ex[$i][0]}}, $temp_eej_new);
				}
			}
		}
	}
	#Union multi-exon transcripts sharing an internal splice site
	foreach my $temp_index (\%temp_donor, \%temp_acceptor){
		foreach my $temp_coord (keys %{$temp_index}){
			my $temp_list = $temp_index->{$temp_coord};
			for(my $i = 1; $i < @{$temp_list}; $i++){
				merge_sub_loci(\%temp_rep_transcript, \%temp_sub_loci_size, \%temp_rep_region, $temp_list->[0], $temp_list->[$i]);
			}
		}
	}
	#Union single-exon transcripts with anything their interval overlaps
	if(@temp_single){
		my @temp_all_exon = ();
		foreach my $temp_key (keys %temp_exons){
			foreach my $temp_ex (@{$temp_exons{$temp_key}}){
				push(@temp_all_exon, [$temp_ex->[0], $temp_ex->[1], $temp_key]);
			}
		}
		@temp_all_exon = sort { $a->[0] <=> $b->[0] } @temp_all_exon;
		foreach my $temp_s (@temp_single){
			my ($temp_sl, $temp_sr) = @{$temp_exons{$temp_s}[0]};
			foreach my $temp_ex (@temp_all_exon){
				last if $temp_ex->[0] > $temp_sr;   #sorted by start: no further overlaps
				next if $temp_ex->[1] < $temp_sl;   #ends before the single-exon starts
				next if $temp_ex->[2] eq $temp_s;   #skip self
				merge_sub_loci(\%temp_rep_transcript, \%temp_sub_loci_size, \%temp_rep_region, $temp_s, $temp_ex->[2]);
			}
		}
	}
	#Assign sub-locus numbers (unchanged from the original)
	my $temp_sub_loci_count = 0;
	foreach my $temp_transcript (sort {$temp_rep_region{$a}[0] <=> $temp_rep_region{$b}[0]} keys %temp_rep_region){
		if($temp_transcript eq $temp_rep_transcript{$temp_transcript}){
			$temp_sub_loci_count++;
			$temp_sub_loci{$temp_transcript} = $temp_sub_loci_count;
			$temp_sub_loci_region{$temp_sub_loci_count} = $temp_rep_region{$temp_transcript};
			delete $temp_rep_region{$temp_transcript};
		}
	}
	foreach my $temp_transcript (keys %temp_rep_transcript){
		if($temp_transcript ne $temp_rep_transcript{$temp_transcript}){
			$temp_sub_loci{$temp_transcript} = $temp_sub_loci{find_rep_transcript(\%temp_rep_transcript, $temp_transcript)};
			delete $temp_rep_region{$temp_transcript};
		}
	}

	return (\%temp_sub_loci, \%temp_sub_loci_region);
}

#Print the record in gtf format and the expression level
sub print_gtf_exp{
	my ($temp_loci_ref, $temp_sample_ref, $temp_chr, $temp_dir, $temp_in, $temp_exp, $temp_prefix) = @_;
	my %temp_strand_flag = ('+', 0, '-', 1);
	my $temp_exp_fh;
	open(my $temp_gtf_fh, "> ${temp_dir}/${temp_chr}.gtf") or die "<ERROR> Cannot create ${temp_dir}/${temp_chr}.gtf!\n";
	if($temp_exp){
		open($temp_exp_fh, "> ${temp_dir}/${temp_chr}_exp.txt") or die "<ERROR> Cannot create ${temp_dir}/${temp_chr}_exp.txt!\n";
	}
	open(my $temp_id_fh, "> ${temp_dir}/${temp_chr}_id.txt") or die "<ERROR> Cannot create ${temp_dir}/${temp_chr}_id.txt!\n";
	foreach my $temp_strand (keys %$temp_loci_ref){
		my $temp_locus_count = 1;
		foreach my $temp_locus (@{$temp_loci_ref->{$temp_strand}}){
			my ($temp_sub_loci_ref, $temp_sub_loci_region_ref) = locus_sub_cluster($temp_locus);
			#print "$temp_chr\t$temp_strand\t$temp_loci\n";
			foreach my $temp_sub_locus (keys %$temp_sub_loci_region_ref){
				print $temp_gtf_fh "$temp_chr\tISOP\tgene\t$temp_sub_loci_region_ref->{$temp_sub_locus}->[0]\t$temp_sub_loci_region_ref->{$temp_sub_locus}->[1]\t.\t$temp_strand\t.\tgene_id \"${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}_${temp_sub_locus}\"\;\n";
			}
			my $temp_transcript_count = 1;
			foreach my $temp_eej (sort keys %{$temp_locus->[2]}){
				foreach my $temp_transcript (@{$temp_locus->[2]->{$temp_eej}}){
					my $temp_eej_new = $temp_transcript->[0]. $temp_eej . $temp_transcript->[1];
					my @temp_eej = split(',', $temp_eej_new);
					my $temp_num_exon = @temp_eej;
					print $temp_gtf_fh "$temp_chr\tISOP\ttranscript\t$temp_transcript->[0]\t$temp_transcript->[1]\t.\t$temp_strand\t.\tgene_id \"${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}_$temp_sub_loci_ref->{$temp_eej_new}\"\; transcript_id \"${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}.${temp_transcript_count}\"\;\n";
					for(my $i = 0; $i < $temp_num_exon; $i++){
						my $temp_cur_exon_num;
						my @temp_exon = split('-', $temp_eej[$i]);
						#Handle exon number for record at the negative strand
						if($temp_strand eq "-"){
							$temp_cur_exon_num = $temp_num_exon - $i;
						}
						#Handle exon number for record at the positive and no strand
						else{
							$temp_cur_exon_num = $i + 1;
						}
						print $temp_gtf_fh "$temp_chr\tISOP\texon\t$temp_exon[0]\t$temp_exon[1]\t.\t$temp_strand\t.\tgene_id \"${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}_$temp_sub_loci_ref->{$temp_eej_new}\"\; transcript_id \"${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}.${temp_transcript_count}\"\; exon_number \"$temp_cur_exon_num\"\;\n";
					}
					if($temp_exp){
						print $temp_exp_fh "${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}.${temp_transcript_count}";
						foreach my $temp_exp_val (unpack("d*", $temp_transcript->[2])){
							print $temp_exp_fh "\t$temp_exp_val";
						}
						print $temp_exp_fh "\n";
					}
					my $temp_id = join(",", keys %{$temp_transcript->[3]});
					my $temp_num_id = keys %{$temp_transcript->[3]};
					my @temp_ends = ();
					foreach my $temp_ends (sort {$temp_transcript->[4]->{$b} <=> $temp_transcript->[4]->{$a}} keys %{$temp_transcript->[4]}){
						my $temp_ends_string = "$temp_ends:$temp_transcript->[4]->{$temp_ends}";
						push(@temp_ends, $temp_ends_string);
					}
					my $temp_ends = join(",", @temp_ends);
					print $temp_id_fh "$temp_chr\t$temp_strand\t${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}_$temp_sub_loci_ref->{$temp_eej_new}\t${temp_prefix}_${temp_chr}_$temp_strand_flag{$temp_strand}_${temp_locus_count}.${temp_transcript_count}\t$temp_id\t$temp_num_id\t$temp_ends\n";
					$temp_transcript_count++;
				}
			}
			$temp_locus_count++;
		}
	}
	close $temp_gtf_fh;
	if($temp_exp){
		close $temp_exp_fh;
	}
	close $temp_id_fh;

	return 1;
}
